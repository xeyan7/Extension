{
  "manifest_version": 3,
  "name": "UI Component Copier",
  "version": "2.0.0",
  "description": "Inspect any webpage, copy production-ready components, and collect images, fonts, colors, SVGs, gradients, video, audio, and Lottie assets.",
  "permissions": [
    "activeTab",
    "storage",
    "scripting",
    "webRequest",
    "webNavigation",
    "downloads",
    "tabs",
    "clipboardWrite",
    "offscreen"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "action": {
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    },
    "default_title": "UI Component Copier"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["lib/gsap.min.js", "lib/tailwind-lib.js", "lib/extractor.js", "lib/preview.js", "content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "matches": ["<all_urls>"],
      "resources": ["lib/postcss.js"]
    }
  ],
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  }
}
